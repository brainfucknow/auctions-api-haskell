cabal-version:       2.4
name:                auction-site
version:             0.1.0.0
synopsis:            Haskell auction REST API
description:         Event-sourced auction engine with multiple auction types
homepage:            https://github.com/wallymathieu/auction-site-haskell
license:             MIT
license-file:        LICENSE
author:              Oskar Gewalli
maintainer:          oskar@gewalli.se
copyright:           2017 Oskar Gewalli
category:            Web
build-type:          Simple
extra-source-files:  README.md

library
  hs-source-dirs:      src
  exposed-modules:      AuctionSite.Money
                      , AuctionSite.Aeson
                      , AuctionSite.Domain
                      , AuctionSite.Domain.Auctions
                      , AuctionSite.Domain.Bids
                      , AuctionSite.Domain.Core
                      , AuctionSite.Domain.SingleSealedBid
                      , AuctionSite.Domain.TimedAscending
                      , AuctionSite.Domain.States
                      , AuctionSite.Domain.Commands
                      , AuctionSite.Persistence.JsonFile
                      , AuctionSite.Web.Types
                      , AuctionSite.Web.App
                      , AuctionSite.Web.Jwt
                      , AuctionSite.Worker
  ghc-options:        -Wall -fwarn-tabs
  other-modules:
  build-depends:       base
                      , containers
                      , aeson
                      , Spock
                      , http-types
                      , text
                      , time
                      , bytestring
                      , parsec
                      , base64-bytestring
                      , stm
                      , async
                      , directory
  default-language:    GHC2021

executable auction-site-exe
  hs-source-dirs:      app
  main-is:             Main.hs
  ghc-options:         -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:        base
                      , containers
                      , Spock
                      , auction-site
                      , time
                      , stm
                      , async
  default-language:    GHC2021

test-suite auction-site-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  ghc-options:        -Wall -fwarn-tabs -Wno-missing-signatures -threaded -rtsopts -with-rtsopts=-N
  build-depends:        base
                      , containers
                      , Spock
                      , auction-site
                      , aeson
                      , time
                      , text
                      , hspec
                      , hspec-wai
                      , hspec-wai-json
                      , wai-extra
                      , vector
                      , bytestring
                      , http-types
                      , directory
  other-modules:        SampleData
                      , AuctionStateSpecs
                      , EnglishAuctionSpec
                      , VickreyAuctionSpec
                      , BlindAuctionStateSpec
                      , ApiSerializationSpec
                      , ApiSpec
                      , SerializationSpec
  default-language:    GHC2021

source-repository head
  type:     git
  location: https://github.com/wallymathieu/auction-site-haskell
